<?xml version="1.0"?>
<ruleset name="iFly Nepal Booking">
	<description>WordPress coding standards for the iFly Nepal Booking plugin.</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/js/vendor/*</exclude-pattern>

	<!--
		scratchpad/ holds one-off CLI scripts — the migrations and the seeders —
		which are development tools and are not part of what the plugin ships.
		They print to a terminal rather than to a browser, so the escaping sniff
		flags every printf in them and the gate stops meaning anything. Excluded
		so a clean run is a statement about the plugin.
	-->
	<exclude-pattern>/scratchpad/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<properties>
			<property name="minimum_wp_version" value="6.5"/>
		</properties>
	</rule>

	<!--
		iflynepal_booking_kses_text() runs its argument through wp_kses() with a
		whitelist of four inline tags. Its return value is finished, safe markup,
		which is exactly what the sniff cannot work out for itself. Declared here
		once, the way the theme declares its render callbacks, rather than
		scattering phpcs:ignore comments through the templates.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="iflynepal_booking_kses_text"/>
				<element value="iflynepal_enquiry_status_pill"/>
			</property>
		</properties>
	</rule>

	<!--
		WordPress resolves templates by a file name it builds from the post type
		and taxonomy keys, and those keys contain underscores
		(iflynepal_package, iflynepal_package_type). A theme overriding one of
		these has to use the same name. So the underscores are required by core,
		not a lapse, and renaming the files to satisfy the sniff would break the
		override path the template loader documents. Scoped to templates/ so the
		rule still applies everywhere a name is actually a choice.
	-->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/templates/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="iflynepal"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="iflynepal"/>
				<element value="IFLYNEPAL"/>
				<element value="IFly_Nepal"/>
			</property>
		</properties>
	</rule>
</ruleset>
